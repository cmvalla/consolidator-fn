{"batch_id": "fe595147a4851c99fd4917e6a8837b8e65ae962fd25a2f1148ba6b511f28969c", "chunk_number": 0, "extracted_graph_data": {"entities": [{"id": "entity_01", "type": "Person", "name": "nonna", "properties": {"description": "Little Red Riding Hood's grandmother, who is very sick."}}, {"id": "entity_02", "type": "Location", "name": "bosco", "properties": {"description": "A forest, where the grandmother lives and Little Red Riding Hood meets the wolf."}}, {"id": "entity_03", "type": "Location", "name": "villaggio", "properties": {"description": "A village, located far from where the grandmother lives."}}, {"id": "entity_04", "type": "Person", "name": "cappuccetto rosso", "properties": {"description": "A young girl going to visit her sick grandmother, known as Little Red Riding Hood."}}, {"id": "entity_05", "type": "Character", "name": "lupo", "properties": {"description": "A cunning and malicious wolf who encounters Little Red Riding Hood. He is described as a 'bad beast'."}}, {"id": "entity_06", "type": "Food", "name": "focaccia", "properties": {"description": "A type of Italian flatbread that Little Red Riding Hood is bringing to her grandmother."}}, {"id": "entity_07", "type": "Food", "name": "succo di frutta", "properties": {"description": "Fruit juice that Little Red Riding Hood is bringing to her grandmother."}}, {"id": "entity_08", "type": "Person", "name": "mamma", "properties": {"description": "Little Red Riding Hood's mother, who prepared the food and drink for the grandmother."}}, {"id": "entity_09", "type": "Location", "name": "casa della nonna", "properties": {"description": "The grandmother's house, a specific dwelling located within the forest."}}, {"id": "entity_10", "type": "Location_Feature", "name": "tre grosse querce", "properties": {"description": "Three large oak trees, serving as a landmark near the grandmother's house."}}, {"id": "chunk-fe595147a4851c99fd4917e6a8837b8e65ae962fd25a2f1148ba6b511f28969c-0", "type": "Chunk", "properties": {"original_text": "la nonna abitava nel bosco, lontano dal villaggio. quando cappuccetto rosso giunse nel bosco, incontr\u00f2 il lupo. ma non sapeva che fosse una bestia tanto cattiva e non ebbe paura. \u2013 buongiorno, cappuccetto rosso \u2013 disse il lupo \u2013 dove stai andando? \u2013 dalla nonna che \u00e8 molto malata \u2013 rispose la bambina \u2013 vado a portarle una focaccia e una bottiglia di succo di frutta che le manda la mia mamma. \u2013 e dove abita la tua nonnina, cappuccetto rosso? \u2013 chiese il lupo \u2013 lontano da qui, nel bosco, sotto le tre grosse querce c'\u00e8 la sua casa. \u00abquesta bimba tenerella \u00e8 un grasso boccone\u00bb pens\u00f2 il lupo \u00absar\u00e0 pi\u00f9 saporita della nonna... se sei furbo, le acchiappi tutt'e due!\u00bb.", "summary": "On her way to her sick grandmother's house, Little Red Riding Hood innocently tells a predatory wolf her destination, prompting his plan to eat them both.", "chunk_number": 0}}, {"id": "community-chunk-fe595147a4851c99fd4917e6a8837b8e65ae962fd25a2f1148ba6b511f28969c-0", "type": "Community", "properties": {"name": "Community for Chunk 0", "summary": "On her way to her sick grandmother's house, Little Red Riding Hood innocently tells a predatory wolf her destination, prompting his plan to eat them both.", "community_type": "contextual"}}], "relationships": [{"source": "entity_01", "target": "entity_02", "type": "ABITAVA_NEL", "properties": {"confidence": 1.0, "description": "The grandmother lived in the forest.", "weight": 1.0}}, {"source": "entity_01", "target": "entity_03", "type": "ABITAVA_LONTANO_DAL", "properties": {"confidence": 1.0, "description": "The grandmother lived far from the village.", "weight": 1.0}}, {"source": "entity_04", "target": "entity_02", "type": "GIUNSE_NEL", "properties": {"confidence": 1.0, "description": "Little Red Riding Hood arrived in the forest.", "weight": 1.0}}, {"source": "entity_04", "target": "entity_05", "type": "INCONTR\u00d2", "properties": {"confidence": 1.0, "description": "Little Red Riding Hood met the wolf.", "weight": 1.0}}, {"source": "entity_04", "target": "entity_05", "type": "NON_EBBE_PAURA_DI", "properties": {"confidence": 1.0, "description": "Little Red Riding Hood was not afraid of the wolf.", "weight": 1.0}}, {"source": "entity_05", "target": "entity_04", "type": "PARL\u00d2_A", "properties": {"confidence": 1.0, "dialogue_content": "Good morning, Little Red Riding Hood - where are you going?", "description": "The wolf spoke to Little Red Riding Hood.", "weight": 1.0}}, {"source": "entity_04", "target": "entity_05", "type": "RISPOSE_A", "properties": {"confidence": 1.0, "dialogue_content": "To grandmother who is very sick - I'm going to bring her a focaccia and a bottle of fruit juice that my mom sends her.", "description": "Little Red Riding Hood replied to the wolf.", "weight": 1.0}}, {"source": "entity_04", "target": "entity_01", "type": "\u00c8_PARENT_DI", "properties": {"confidence": 0.9, "role": "granddaughter", "description": "Little Red Riding Hood is the granddaughter of the grandmother.", "weight": 0.9}}, {"source": "entity_04", "target": "entity_06", "type": "PORTA", "properties": {"confidence": 1.0, "purpose": "to_grandmother", "description": "Little Red Riding Hood is bringing focaccia.", "weight": 1.0}}, {"source": "entity_04", "target": "entity_07", "type": "PORTA", "properties": {"confidence": 1.0, "purpose": "to_grandmother", "description": "Little Red Riding Hood is bringing fruit juice.", "weight": 1.0}}, {"source": "entity_08", "target": "entity_06", "type": "MANDA", "properties": {"confidence": 1.0, "recipient": "entity_01", "description": "The mother sends focaccia for the grandmother.", "weight": 1.0}}, {"source": "entity_08", "target": "entity_07", "type": "MANDA", "properties": {"confidence": 1.0, "recipient": "entity_01", "description": "The mother sends fruit juice for the grandmother.", "weight": 1.0}}, {"source": "entity_04", "target": "entity_08", "type": "\u00c8_FIGLIA_DI", "properties": {"confidence": 0.9, "description": "Little Red Riding Hood is the daughter of the mother.", "weight": 0.9}}, {"source": "entity_05", "target": "entity_04", "type": "CHIESE_A", "properties": {"confidence": 1.0, "dialogue_content": "And where does your grandmother live, Little Red Riding Hood?", "description": "The wolf asked Little Red Riding Hood.", "weight": 1.0}}, {"source": "entity_01", "target": "entity_09", "type": "ABITA_IN", "properties": {"confidence": 1.0, "description": "The grandmother lives in her house.", "weight": 1.0}}, {"source": "entity_09", "target": "entity_02", "type": "SI_TROVA_NEL", "properties": {"confidence": 1.0, "description": "The grandmother's house is located in the forest.", "weight": 1.0}}, {"source": "entity_09", "target": "entity_10", "type": "SI_TROVA_SOTTO", "properties": {"confidence": 1.0, "description": "The grandmother's house is located under three large oak trees.", "weight": 1.0}}, {"source": "entity_05", "target": "entity_04", "type": "HA_PENSIERO_SU", "properties": {"confidence": 1.0, "thought": "This tender child is a fat mouthful.", "description": "The wolf had a thought about Little Red Riding Hood.", "weight": 1.0}}, {"source": "entity_05", "target": "entity_01", "type": "HA_PENSIERO_SU", "properties": {"confidence": 1.0, "thought": "She will be tastier than the grandmother...", "description": "The wolf had a thought about the grandmother.", "weight": 1.0}}, {"source": "entity_05", "target": "entity_04", "type": "DESIDERA_CATTURARE", "properties": {"confidence": 1.0, "description": "The wolf desires to catch Little Red Riding Hood.", "weight": 1.0}}, {"source": "entity_05", "target": "entity_01", "type": "DESIDERA_CATTURARE", "properties": {"confidence": 1.0, "description": "The wolf desires to catch the grandmother.", "weight": 1.0}}, {"source": "entity_05", "target": "entity_04", "type": "PREFERISCE_A_LIVELLO_GUSTATIVO", "properties": {"confidence": 1.0, "compared_to_entity": "entity_01", "description": "The wolf prefers Little Red Riding Hood taste-wise compared to the grandmother.", "weight": 1.0}}, {"source": "chunk-fe595147a4851c99fd4917e6a8837b8e65ae962fd25a2f1148ba6b511f28969c-0", "target": "community-chunk-fe595147a4851c99fd4917e6a8837b8e65ae962fd25a2f1148ba6b511f28969c-0", "type": "BELONGS_TO_COMMUNITY", "properties": {"weight": 0.5, "description": "Indicates that a text chunk belongs to a specific community."}}, {"source": "entity_01", "target": "chunk-fe595147a4851c99fd4917e6a8837b8e65ae962fd25a2f1148ba6b511f28969c-0", "type": "ARE_PART_OF_CHUNK", "properties": {"weight": 1, "description": "Indicates that an extracted entity is part of a specific text chunk."}}, {"source": "entity_02", "target": "chunk-fe595147a4851c99fd4917e6a8837b8e65ae962fd25a2f1148ba6b511f28969c-0", "type": "ARE_PART_OF_CHUNK", "properties": {"weight": 1, "description": "Indicates that an extracted entity is part of a specific text chunk."}}, {"source": "entity_03", "target": "chunk-fe595147a4851c99fd4917e6a8837b8e65ae962fd25a2f1148ba6b511f28969c-0", "type": "ARE_PART_OF_CHUNK", "properties": {"weight": 1, "description": "Indicates that an extracted entity is part of a specific text chunk."}}, {"source": "entity_04", "target": "chunk-fe595147a4851c99fd4917e6a8837b8e65ae962fd25a2f1148ba6b511f28969c-0", "type": "ARE_PART_OF_CHUNK", "properties": {"weight": 1, "description": "Indicates that an extracted entity is part of a specific text chunk."}}, {"source": "entity_05", "target": "chunk-fe595147a4851c99fd4917e6a8837b8e65ae962fd25a2f1148ba6b511f28969c-0", "type": "ARE_PART_OF_CHUNK", "properties": {"weight": 1, "description": "Indicates that an extracted entity is part of a specific text chunk."}}, {"source": "entity_06", "target": "chunk-fe595147a4851c99fd4917e6a8837b8e65ae962fd25a2f1148ba6b511f28969c-0", "type": "ARE_PART_OF_CHUNK", "properties": {"weight": 1, "description": "Indicates that an extracted entity is part of a specific text chunk."}}, {"source": "entity_07", "targe